{
  "name": "nandyal-ride-demo",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:customer": "APP_VARIANT=customer EXPO_PUBLIC_APP_MODE=customer expo start --clear",
    "start:captain": "APP_VARIANT=captain EXPO_PUBLIC_APP_MODE=captain expo start --clear",
    "start:demo": "APP_VARIANT=chooser EXPO_PUBLIC_APP_MODE=chooser expo start --clear",
    "android": "expo run:android",
    "android:customer": "APP_VARIANT=customer EXPO_PUBLIC_APP_MODE=customer expo start --android --clear",
    "android:captain": "APP_VARIANT=captain EXPO_PUBLIC_APP_MODE=captain expo start --android --clear",
    "ios": "expo run:ios",
    "ios:customer": "APP_VARIANT=customer EXPO_PUBLIC_APP_MODE=customer expo start --ios --clear",
    "ios:captain": "APP_VARIANT=captain EXPO_PUBLIC_APP_MODE=captain expo start --ios --clear",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "expo prebuild --clean --no-install --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/noto-sans-telugu": "^0.2.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.3.26",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.17",
    "expo-status-bar": "~3.0.8",
    "i18next": "^25.5.2",
    "react": "19.1.0",
    "react-i18next": "^16.0.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
