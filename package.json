{
  "name": "@sawaari/workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "dashboard"
  ],
  "scripts": {
    "dashboard:dev": "npm run dev --workspace dashboard",
    "dashboard:build": "npm run build --workspace dashboard",
    "dashboard:typecheck": "npm run typecheck --workspace dashboard",
    "health:audit": "node monitoring/health/index.mjs",
    "start:customer": "npm run start --workspace @sawaari/customer",
    "start:captain": "npm run start --workspace @sawaari/captain",
    "android:customer": "npm run android --workspace @sawaari/customer",
    "android:captain": "npm run android --workspace @sawaari/captain",
    "ios:customer": "npm run ios --workspace @sawaari/customer",
    "ios:captain": "npm run ios --workspace @sawaari/captain",
    "typecheck:customer": "npm run typecheck --workspace @sawaari/customer",
    "typecheck:captain": "npm run typecheck --workspace @sawaari/captain",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "expo": "~54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
