{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "staging": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "preview",
      "channel": "staging-captain",
      "env": {
        "APP_VARIANT": "captain",
        "SAWAARI_ENVIRONMENT": "staging",
        "EXPO_PUBLIC_APP_MODE": "captain",
        "EXPO_PUBLIC_AUTH_MODE": "production"
      }
    },
    "internal": {
      "distribution": "internal",
      "environment": "production",
      "channel": "production-captain",
      "env": {
        "APP_VARIANT": "captain",
        "EXPO_PUBLIC_APP_MODE": "captain",
        "EXPO_PUBLIC_AUTH_MODE": "production"
      }
    },
    "production": {
      "environment": "production",
      "channel": "production-captain",
      "env": {
        "APP_VARIANT": "captain",
        "EXPO_PUBLIC_APP_MODE": "captain",
        "EXPO_PUBLIC_AUTH_MODE": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}