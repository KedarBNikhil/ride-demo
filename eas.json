{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-customer": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_APP_MODE": "customer"
      }
    },
    "development-captain": {
      "extends": "development",
      "env": {
        "APP_VARIANT": "captain",
        "EXPO_PUBLIC_APP_MODE": "captain"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production-customer": {
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_APP_MODE": "customer"
      }
    },
    "production-captain": {
      "env": {
        "APP_VARIANT": "captain",
        "EXPO_PUBLIC_APP_MODE": "captain"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
